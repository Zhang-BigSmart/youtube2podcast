{
  "name": "youtube2podcast",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @youtube2podcast/server dev",
    "build:extension": "pnpm --filter @youtube2podcast/extension build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "supportedArchitectures": {
      "os": ["current", "linux"],
      "cpu": ["current", "x64", "arm64"]
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.5.4"
  }
}
