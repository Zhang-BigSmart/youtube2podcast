{
  "name": "@youtube2podcast/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/server.js --external:sharp",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "hono": "^4.9.8",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "esbuild": "^0.25.9",
    "tsx": "^4.20.5",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
